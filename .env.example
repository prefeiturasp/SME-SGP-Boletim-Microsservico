DJANGO_SECRET_KEY=chave-local-nao-utilizar-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
API_KEY=dev-key-default
API_KEY_HEADER=X-API-Key
PEDAGOGICO_API_URL=
PEDAGOGICO_API_KEY=
PEDAGOGICO_API_KEY_HEADER=x-api-eol-key
BEARER_TOKEN_SIGNING_KEY=chave-local-com-32-bytes-substituir-em-producao
BEARER_TOKEN_ISSUER=aplicacao-dotnet
BEARER_TOKEN_AUDIENCE=sme-sgp-boletim-ms
BEARER_TOKEN_ALGORITHMS=HS256
PORT_WEB=8001
PORT_DEBUGPY=5678
URL_BANCO_BOLETIM=
DB_POOL_SIZE=5
KEYDB_URL=redis://keydb:6379/0
CACHE_BOLETIM_TTL=1800
CACHE_ABRANGENCIA_TTL=300
CACHE_LOCK_TTL=30
CACHE_LOCK_WAIT_TIMEOUT=2

SME_SDK_ENABLED=true
SME_SERVICE_NAME=sme_sgp_boletim_ms
